{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dhaka World Builder",
  "version": "0.1.0",
  "identifier": "com.tanvirpersonal.dhakaworldbuilder",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dhaka World Builder",
        "width": 1600,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
