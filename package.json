{
  "name": "dhaka-world-builder",
  "private": true,
  "version": "0.1.0",
  "description": "Browser-based tool that imports real Dhaka map data, builds an editable 3D city and exports game-ready GLB assets.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm test",
    "desktop:dev": "npx --yes @tauri-apps/cli@2 dev",
    "desktop:build": "npx --yes @tauri-apps/cli@2 build"
  },
  "dependencies": {
    "maplibre-gl": "^6.16.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "fake-indexeddb": "^6.2.7",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
